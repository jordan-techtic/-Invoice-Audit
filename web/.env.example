# Frontend settings. Docker: copy to web/.env (docker compose reads it). Without Docker: `API_URL=... npm run dev`.
# Where the Next.js /api proxy sends requests. Must be reachable from the web server, not from the browser.
# With web/docker-compose.yml the default is http://api:8000 (the backend container on the shared `invoice-audit` network).
API_URL=http://127.0.0.1:8000
