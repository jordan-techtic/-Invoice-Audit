# Copy to .env. docker compose reads it automatically.
# For local API without Docker, use api/.env.example → api/.env (see README).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
# openai (default) | claude | fake  (fake = deterministic offline provider used by tests)
AI_PROVIDER=openai
# Optional: run RQ jobs in-process (no worker container): QUEUE_INLINE=true
QUEUE_INLINE=
# Generate with: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
JWT_SECRET=
# Phase 2 extraction settings
CLAUDE_MODEL=claude-sonnet-5-5
CONFIDENCE_THRESHOLD=0.80
EXTRACTION_RETRIES=1
# Set true once zero data retention is confirmed with Anthropic (required for real client data)
AI_ZDR_CONFIRMED=false
# For offline demos / Playwright: AI_PROVIDER=fake and FAKE_PROVIDER_DEMO=true
FAKE_PROVIDER_DEMO=
# Redact VINs and phone numbers in TEXT sent to the AI (images are not masked)
AI_REDACT_BEFORE_SEND=false
# Raw invoice files are deleted this many days after the audit is marked complete
RAW_FILE_RETENTION_DAYS=90