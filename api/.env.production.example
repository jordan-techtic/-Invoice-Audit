# Production api/.env (PM2 / host install). Copy to api/.env on the server.
ENV=production

DATABASE_URL=postgresql+psycopg://audit:CHANGE_ME@127.0.0.1:5432/audit
REDIS_URL=redis://127.0.0.1:6379/0

# true = jobs run inside the API request (simple, no Redis). false = need invoice-audit-worker in PM2.
QUEUE_INLINE=true

# postgres ok for small installs; use s3 for production file volume
STORAGE_BACKEND=s3
S3_REGION=us-east-1
S3_BUCKET=invoice-audit-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_ENDPOINT_URL=   # leave empty for AWS S3

JWT_SECRET=generate-a-long-random-string
DATA_ENCRYPTION_KEY=  # python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PUBLIC_BASE_URL=https://audit.yourdomain.com
COOKIE_SECURE=true
AUTH_DISABLED=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_PROVIDER=openai
AI_ENABLED=true
AI_ZERO_RETENTION_REQUIRED=true
AI_ZDR_CONFIRMED=true

INBOUND_EMAIL_SECRET=change-me