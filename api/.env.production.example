# Production api/.env (PM2 / host install). Copy to api/.env on the server.
# REQUIRED when ENV=production (generate on the server, do not leave placeholders):
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"   # DATA_ENCRYPTION_KEY
#   openssl rand -hex 32                                                                    # JWT_SECRET
#   openssl rand -hex 16                                                                    # INBOUND_EMAIL_SECRET
ENV=production

DATABASE_URL=postgresql+psycopg://audit:audit@127.0.0.1:5432/audit
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_INLINE=true

# Staging / POC without AWS: postgres. Production file volume: s3 + credentials below.
STORAGE_BACKEND=postgres

JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
DATA_ENCRYPTION_KEY=REPLACE_WITH_fernet_key_from_python_command_above
PUBLIC_BASE_URL=http://YOUR_SERVER_IP:8686
COOKIE_SECURE=false
AUTH_DISABLED=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_PROVIDER=openai
AI_ENABLED=true
AI_ZERO_RETENTION_REQUIRED=true
AI_ZDR_CONFIRMED=true

INBOUND_EMAIL_SECRET=change-me