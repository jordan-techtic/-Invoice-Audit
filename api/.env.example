# Copy to api/.env — backend reads this when you run uvicorn from api/
ENV=local

DATABASE_URL=postgresql+psycopg://audit:audit@127.0.0.1:5432/audit
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_INLINE=true

STORAGE_BACKEND=postgres

JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_PROVIDER=openai
FAKE_PROVIDER_DEMO=false
AI_ENABLED=true
AI_ZERO_RETENTION_REQUIRED=false
AI_ZDR_CONFIRMED=false